<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SoundscapeMapper" parent="android:Theme.Material.NoActionBar">
        <!-- Compatibilidad nativa con Android 12+ Splash Screen API -->
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
